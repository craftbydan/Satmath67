# Database (defaults to a local SQLite file if unset)
DATABASE_URL=sqlite+aiosqlite:///./pj.db

# OpenAI (used for pj's LLM responses)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-nano

# Optional: used only by `python seed.py add-tenant --from-env ...` as a
# convenience default for your first tenant's LINE credentials. Runtime
# webhook handling always reads channel_secret/channel_access_token from
# the tenants table instead.
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token_here

# Google service account used by the Calendar/Drive tools (check_teacher_
# availability, search_student_materials, update_calendar_slot,
# upload_material). Set exactly ONE of the two below.
#
# Its `client_email` must be shared as an editor on each tenant's Google
# Calendar and Drive materials folder -- see README "Google service
# account setup".
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Phase 4: background jobs
# IANA timezone the 8:00 AM daily digest fires in, e.g. "Asia/Bangkok".
DIGEST_TIMEZONE=UTC
# Hours a session request can sit unconfirmed before the reminder job flags it.
STALE_REQUEST_HOURS=24
# Only set to "true" if this process is your ONE always-on instance running
# the in-process scheduler (worker.py does this too / instead). Leave
# "false" when using Render's native Cron Jobs (run_job.py) -- see README
# "Background jobs in production".
ENABLE_SCHEDULER=false

# Local server port
PORT=8000
